<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="intro_hook">오발있? (오늘 발로란트 할 사람 있어?)</string>
    <string name="intro_headline">그전에 이번 주 전적부터 살펴볼까</string>
    <string name="intro_subtitle">내 발로란트 전적 지표가 어떻게 움직였는지 매주 짚어 드려요</string>
    <string name="intro_start">Riot 계정으로 시작하기</string>

    <!-- S0-2 연동 동의. 목업 문구 그대로다. 심사자가 목업과 나란히 놓고 본다 -->
    <string name="consent_title">Riot 계정을 연동할게요.</string>
    <string name="consent_matches_title">최근 50경기를 불러와요</string>
    <string name="consent_matches_body">경쟁과 일반 경기를 라운드 단위로 분석해요. 처음 한 번만 1분 정도 걸려요.</string>
    <string name="consent_public_title">전적이 다른 사용자에게 공개돼요</string>
    <string name="consent_public_body">계정을 연동하면 회원님의 발로란트 전적이 이 앱의 다른 사용자에게 공개돼요.</string>
    <string name="consent_unlink_title">언제든 해제할 수 있어요</string>
    <string name="consent_unlink_body">설정에서 연동을 해제하면 저장된 데이터도 같이 지워요.</string>
    <string name="consent_password">비밀번호는 Riot 로그인 페이지에서만 입력해요. 이 앱은 비밀번호를 받지도, 저장하지도 않아요.</string>
    <string name="consent_continue">Riot 계정으로 계속하기</string>
    <string name="consent_note">계속하면 Riot Games 로그인 페이지로 이동해요.</string>

    <!-- S0-4 불러오는 중 -->
    <string name="import_title">어떤 게 제일 궁금하세요?</string>
    <string name="import_subtitle">고르신 쪽을 리포트 위에 올려드려요. 나중에 설정에서 바꿔도 돼요.</string>
    <string name="import_loading">경기를 불러오고 있어요</string>
    <string name="import_count">%1$d / %2$d</string>
    <string name="import_background">앱을 닫아도 계속 분석해요. 다 모으면 알림으로 알려드릴게요.</string>
    <string name="import_done">%1$d경기를 다 불러왔어요</string>
    <string name="import_done_none">최근 8주 동안 뛴 경기가 없어요</string>
    <string name="import_open_report">리포트 보기</string>
    <string name="import_progress_description">경기 %2$d개 중 %1$d개를 불러왔어요</string>
</resources>
