<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      화면은 전부 Compose로 그립니다. 안드로이드 테마는 창 배경과 스플래시까지만 맡습니다.
    -->
    <style name="Theme.Ovalit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.Ovalit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Ovalit</item>
    </style>

</resources>
