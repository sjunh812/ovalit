{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ovalit",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // 사용자 설정과 상관없이 이 프로젝트의 wrangler 명령은 사용 통계를 보내지 않는다.
  "send_metrics": false,
  // 카드 이미지는 Worker를 거치지 않고 바로 나간다. 정적 에셋 요청은 무료 한도에 세지 않는다.
  "assets": {
    "directory": "./public"
  },
  // 5분마다 곧 시작하는 ㅇㅂㅇ을 알리고 지난 것을 지운다. 월요일 00:00 UTC(09:00 KST)에는 지난주 리포트 알림을 보낸다.
  // 월요일 문자열은 src/scheduled.ts의 WEEKLY_CRON과 같아야 한다.
  "triggers": {
    "crons": ["*/5 * * * *", "0 0 * * 1"]
  },
  // database_id는 계정이 생기면 `wrangler d1 create`가 준 값을 넣는다. 로컬에서는 없어도 돈다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ovalit",
      "migrations_dir": "migrations"
    }
  ]
}
