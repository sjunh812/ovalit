<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- RSO는 Custom Tabs로 띄운다. 기기에 깔린 브라우저를 찾으려면 이 선언이 필요하다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 첫 수집을 마치면 알려 준다. 안드로이드 13부터는 따로 허락을 받는다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OvalitApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Ovalit.Starting">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Ovalit.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- RSO 로그인을 마치면 서버가 이 주소로 돌려보낸다. 서버의 assetlinks.json으로 검증한 App Link라 다른 앱이
                 가로채지 못한다. 커스텀 스킴은 아무 앱이나 같은 이름을 등록할 수 있어서 쓰지 않는다. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${ovalitServerHost}"
                    android:path="/auth/done" />
                <!-- 친구 초대 링크다. 앱이 있으면 바로 열린다. 코드를 받아 요청을 보내는 일은 실제 친구 저장소와 함께 붙인다. -->
                <data
                    android:scheme="https"
                    android:host="${ovalitServerHost}"
                    android:pathPrefix="/i/" />
            </intent-filter>
        </activity>

        <!-- AdMob 앱 ID다. 실제 ID가 없으면 Google 테스트 ID가 들어간다(build.gradle.kts). 광고를 요청할 때까지 SDK가 일을
             미루게 한다. 광고 단위 ID가 없으면 광고를 요청하지 않는다. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />
        <!-- 테스트 광고를 받을 때 광고 위에 뜨는 네이티브 광고 검사 창을 끈다. 실제 광고에는 원래 뜨지 않는다. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED"
            android:value="false" />

        <!-- ㅇㅂㅇ과 주간 리포트 알림을 받는다. Firebase는 local.properties 값으로 앱이 직접 띄운다(OvalitPush). -->
        <service
            android:name=".push.OvalitMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 알림의 갈게, 안 돼, 바꾸기 버튼이다. 앱 안에서만 보낸다. -->
        <receiver
            android:name=".push.PingActionReceiver"
            android:exported="false" />

        <!-- 사용 통계와 비정상 종료 보고는 꺼 둔 채 시작하고, 설정의 "사용 통계 보내기"를 읽은 뒤에 켠다(OvalitFirebase).
             광고 ID는 AdMob만 쓰고, 화면 이름은 고정된 표로 직접 보낸다. 자동으로 모으면 화면 클래스 이름이 난독화돼 쓸모가 없다. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <!-- 값이 없을 때 Firebase가 스스로 토큰을 만들지 않게 막고, 띄운 뒤에 켠다 -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>

</manifest>
