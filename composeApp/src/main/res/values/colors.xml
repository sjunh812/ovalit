<?xml version="1.0" encoding="utf-8"?>
<!--
  Compose가 올라오기 전, 창 배경과 스플래시를 칠할 때만 쓰는 값입니다.

  원시 hex를 화면에 직접 쓰지 않는다는 규칙의 유일한 예외입니다. Compose 밖이라 색 토큰을
  읽을 방법이 없습니다. 여기 값은 core/designsystem의 OvalitColors를 따라갑니다.
  토큰이 바뀌면 values-night도 같이 고칩니다.
-->
<resources>
    <!-- 창 배경만 테마를 따릅니다. OvalitLightColors.bg -->
    <color name="window_background">#FDFCFA</color>

    <!--
      스플래시와 런처 아이콘은 테마를 따르지 않습니다. 둘 다 브랜드 면이라 같은 색을 씁니다.
      런처는 앱의 다크 설정을 모르고, 스플래시는 아이콘에서 이어지는 화면입니다.
    -->
    <!-- OvalitColors.accent -->
    <color name="brand_surface">#E0B252</color>
    <!-- OvalitColors.onAccent -->
    <color name="brand_mark">#100E0C</color>
</resources>
