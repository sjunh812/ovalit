<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="intro_hook">오발있? (오늘 발로란트 할 사람 있어?)</string>
    <string name="intro_headline">그전에 이번 주 전적부터 살펴볼까</string>
    <!-- 무엇을 보여주는지와 얼마나 자주인지를 두 줄로 나눈다. \n 대신 두 문자열로 둔다. -->
    <string name="intro_subtitle_what">내 발로란트 전적이 어떻게 움직였는지</string>
    <string name="intro_subtitle_when">매주 짚어드려요</string>
    <string name="intro_start">Riot 계정으로 시작하기</string>

    <!-- S0-2 연동 동의. 심사자가 목업과 나란히 놓고 보니 목업 문구를 따른다. 공개 범위 두 줄만 친구끼리 본다는 규칙에
         맞춰 바꿨다(DECISIONS 2026-09-27). -->
    <string name="consent_title">Riot 계정을 연동할게요</string>
    <string name="consent_matches_title">최근 50경기를 불러와요</string>
    <string name="consent_matches_body">경쟁과 일반 경기를 라운드 단위로 분석해요. 처음 한 번만 1분 정도 걸려요.</string>
    <string name="consent_public_title">서로 수락한 친구에게 전적이 공개돼요</string>
    <string name="consent_public_body">친구가 되면 서로의 리포트와 경기를 볼 수 있어요. 설정에서 전적 공개를 끄면 친구도 볼 수 없어요.</string>
    <string name="consent_unlink_title">언제든 해제할 수 있어요</string>
    <string name="consent_unlink_body">설정에서 연동을 해제하면 저장된 데이터도 같이 지워요.</string>
    <string name="consent_password">비밀번호는 Riot 로그인 페이지에서만 입력해요. 이 앱은 비밀번호를 받지도, 저장하지도 않아요.</string>
    <string name="consent_continue">Riot 계정으로 계속하기</string>
    <string name="consent_note">계속하면 Riot 로그인 페이지로 이동해요.</string>

    <!-- S0-4 불러오는 중 -->
    <string name="import_title">어떤 게 제일 궁금하세요?</string>
    <string name="import_subtitle">고른 관심사의 지표를 리포트 맨 앞에 보여드려요. 나중에 설정에서 바꿔도 돼요.</string>
    <string name="import_loading">경기를 불러오고 있어요</string>
    <string name="import_count">%1$d / %2$d</string>
    <string name="import_background">앱을 닫아도 계속 불러와요. 다 불러오면 알림을 보내드릴게요.</string>
    <string name="import_done">%1$d경기를 다 불러왔어요</string>
    <string name="import_done_none">최근 8주 동안 뛴 경기가 없어요</string>
    <string name="import_open_report">리포트 보기</string>
    <string name="import_stopped">경기를 다 불러오지 못했어요</string>
    <string name="import_stopped_offline">인터넷에 연결되면 이어서 불러와요.</string>
    <string name="import_stopped_later">잠시 뒤 저절로 이어서 불러와요. 지금 다시 해도 돼요.</string>
    <string name="import_retry">이어서 불러오기</string>
    <string name="import_progress_description">%2$d경기 중 %1$d경기를 불러왔어요</string>
</resources>
