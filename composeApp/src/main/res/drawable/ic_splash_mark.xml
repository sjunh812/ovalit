<?xml version="1.0" encoding="utf-8"?>
<!--
  스플래시 아이콘은 288dp 캔버스에 가운데 192dp만 보입니다.
  런처와 규격이 달라 드로어블을 따로 두고, 그림은 런처와 같은 비율로 보이는 원에 맞춥니다.
  그림은 앱을 켤 때 재생하는 로고 애니메이션(OvalitLaunchAnimation)의 첫 장면입니다.
  말풍선에 입력 중 점 셋을 뚫어 두고, 앱이 뜨면 같은 자리에서 점이 출렁이다 ㅇㅂㅇ이 됩니다.
  말풍선 경로는 ic_launcher_foreground.xml과 같습니다.

  scale = 192 / 1024 = 0.1875
  translate = (288 - 192) / 2 = 48
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <group
        android:scaleX="0.1875"
        android:scaleY="0.1875"
        android:translateX="48"
        android:translateY="48">

        <path
            android:fillColor="@color/brand_mark"
            android:fillType="evenOdd"
            android:pathData="M272,280H752A120,120 0,0 1,872,400V598A120,120 0,0 1,752,718H432L322.5,813.8Q312,823 312,809V718H272A120,120 0,0 1,152,598V400A120,120 0,0 1,272,280ZM358,499a34,34 0,1 0,68,0a34,34 0,1 0,-68,0ZM478,499a34,34 0,1 0,68,0a34,34 0,1 0,-68,0ZM598,499a34,34 0,1 0,68,0a34,34 0,1 0,-68,0Z" />
    </group>
</vector>
