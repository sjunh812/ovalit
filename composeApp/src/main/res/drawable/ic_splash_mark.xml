<?xml version="1.0" encoding="utf-8"?>
<!--
  스플래시 아이콘은 288dp 캔버스에 가운데 192dp만 보입니다.
  런처와 규격이 달라 드로어블을 따로 두고, 그림은 런처와 같은 비율로 보이는 원에 맞춥니다.
  말풍선 경로는 ic_launcher_foreground.xml과 같습니다.

  입력 중 점 셋은 크기 0으로 두고 ic_splash_anim.xml이 띄워 출렁이게 합니다.
  스플래시가 움직이지 않는 안드로이드 12 미만에서는 이 첫 장면인 빈 말풍선만 보입니다.
  점의 자리, 크기, 움직임은 앱이 이어서 그리는 OvalitLaunchAnimation과 같아야 끊기지 않습니다.

  scale = 192 / 1024 = 0.1875
  translate = (288 - 192) / 2 = 48
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <group
        android:scaleX="0.1875"
        android:scaleY="0.1875"
        android:translateX="48"
        android:translateY="48">

        <path
            android:fillColor="@color/brand_mark"
            android:pathData="M272,280H752A120,120 0,0 1,872,400V598A120,120 0,0 1,752,718H432L322.5,813.8Q312,823 312,809V718H272A120,120 0,0 1,152,598V400A120,120 0,0 1,272,280Z" />

        <group
            android:name="dot_0"
            android:pivotX="392"
            android:pivotY="499"
            android:scaleX="0"
            android:scaleY="0">
            <path
                android:fillColor="@color/brand_surface"
                android:pathData="M352,499a40,40 0,1 0,80,0a40,40 0,1 0,-80,0Z" />
        </group>

        <group
            android:name="dot_1"
            android:pivotX="512"
            android:pivotY="499"
            android:scaleX="0"
            android:scaleY="0">
            <path
                android:fillColor="@color/brand_surface"
                android:pathData="M472,499a40,40 0,1 0,80,0a40,40 0,1 0,-80,0Z" />
        </group>

        <group
            android:name="dot_2"
            android:pivotX="632"
            android:pivotY="499"
            android:scaleX="0"
            android:scaleY="0">
            <path
                android:fillColor="@color/brand_surface"
                android:pathData="M592,499a40,40 0,1 0,80,0a40,40 0,1 0,-80,0Z" />
        </group>
    </group>
</vector>
